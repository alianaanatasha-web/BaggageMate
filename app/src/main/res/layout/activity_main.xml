<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7FA">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F28C28"
        android:title="BaggageMate"
        android:titleTextColor="#FFFFFF"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Instructions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Calculate Your Baggage Fee"
                android:textColor="#263238"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Enter your baggage details below to estimate the excess baggage charge."
                android:textColor="#526579"
                android:textSize="14sp" />

            <!-- Input 1: Baggage Weight -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Baggage Weight (kg)"
                android:textColor="#263238"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#F28C28"
                android:hint="e.g. 25.0"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#263238"
                android:textColorHint="#8795A5" />

            <!-- Input 2: Ticket Class -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ticket Class"
                android:textColor="#263238"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTicketClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbEconomy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="6dp"
                    android:buttonTint="#F28C28"
                    android:text="Economy (20 kg limit)"
                    android:textColor="#263238"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbBusiness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:buttonTint="#F28C28"
                    android:text="Business (40 kg limit)"
                    android:textColor="#263238"
                    android:textSize="15sp" />

            </RadioGroup>

            <!-- Input 3: Rate -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Excess Baggage Rate (RM/kg)"
                android:textColor="#263238"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#F28C28"
                android:hint="e.g. 15.00"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="#263238"
                android:textColorHint="#8795A5" />

            <!-- Calculate Button -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#F28C28"
                android:text="CALCULATE FEE"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Results Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculation Results"
                    android:textColor="#263238"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExcessWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Excess weight: -- kg"
                    android:textColor="#526579"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvExcessCharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Excess charge: RM --"
                    android:textColor="#526579"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvServiceTax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Service tax (8%): RM --"
                    android:textColor="#526579"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#DCE5EC" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Total payable: RM --"
                    android:textColor="#E87516"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Helpful Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp"
                android:background="#FFF0DF"
                android:padding="14dp"
                android:text="NOTE: Economy allowance is 20 kg, Business allowance is 40 kg. An 8% service tax is applied to the excess baggage charge."
                android:textColor="#8A4B12"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
